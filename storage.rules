rules_version = '2';
// Firebase Storage Security Rules - deploy via Firebase Console → Storage → Rules
// Agar upload/download gambar (images/, records/) tidak 403

service firebase.storage {
  match /b/{bucket}/o {
    // Gambar dari camera/upload (CameraDetectionFragment, dll)
    match /images/{allPaths=**} {
      allow read, write: if request.auth != null;
    }
    // Gambar rekaman / pertanyaan
    match /records/{allPaths=**} {
      allow read, write: if request.auth != null;
    }
    // Fallback: izinkan path lain untuk user login (opsional)
    match /{allPaths=**} {
      allow read, write: if request.auth != null;
    }
  }
}
