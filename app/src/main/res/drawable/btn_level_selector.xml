<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- State ketika tombol dipilih -->
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/phyphox_purple" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    
    <!-- State ketika tombol ditekan -->
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/phyphox_purple" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    
    <!-- State default -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/phyphox_white_100" />
            <corners android:radius="12dp" />
            <stroke
                android:width="1dp"
                android:color="@color/phyphox_purple" />
        </shape>
    </item>
</selector> 