<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="oval">
            <solid android:color="@color/phyphox_purple" />
            <stroke android:width="4dp" android:color="@color/phyphox_white_100" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="oval">
            <solid android:color="@color/phyphox_purple" />
            <stroke android:width="4dp" android:color="@color/phyphox_white_100" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <solid android:color="@color/phyphox_white_100" />
            <stroke android:width="4dp" android:color="@color/phyphox_purple" />
        </shape>
    </item>
</selector> 