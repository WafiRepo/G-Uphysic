<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:id="@+id/rlView"
    android:background="@drawable/gradient_background"
    tools:context=".activity.DrawActivity">

    <!-- Top Toolbar - More Compact -->
    <androidx.cardview.widget.CardView
        android:id="@+id/top_toolbar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="8dp"
        app:cardCornerRadius="12dp"
        app:cardElevation="4dp"
        app:cardBackgroundColor="@color/phyphox_white_100"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="12dp"
            android:gravity="center">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">

                <TextView
                    android:id="@+id/tv_canvas_header_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🧠 Buat Inquiry"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/phyphox_purple" />

                <TextView
                    android:id="@+id/tv_canvas_header_subtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Tulis inquiry Anda, lalu submit untuk mendapatkan feedback dari LLM."
                    android:textSize="11sp"
                    android:textColor="@color/phyphox_black_60"
                    android:gravity="center"
                    android:maxLines="4"
                    android:ellipsize="end" />

            </LinearLayout>

            <!-- Info/Help Button -->
            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/ivSign"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                app:backgroundTint="@color/phyphox_black_100"
                android:src="@drawable/knowledge"
                app:fabSize="mini"
                android:contentDescription="Bantuan" />

        </LinearLayout>

    </androidx.cardview.widget.CardView>

    <androidx.cardview.widget.CardView
        android:id="@+id/inquiry_input_card"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:layout_marginTop="2dp"
        app:cardCornerRadius="12dp"
        app:cardElevation="4dp"
        app:cardBackgroundColor="@color/phyphox_white_100"
        app:layout_constraintTop_toBottomOf="@id/top_toolbar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <EditText
                android:id="@+id/et_inquiry_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:gravity="top"
                android:hint="Contoh: Berdasarkan grafik ini, apakah hubungan a dan ω linear atau kuadrat?"
                android:inputType="textMultiLine|textCapSentences"
                android:background="@drawable/custom_edittext_background"
                android:padding="10dp"
                android:textColor="@color/phyphox_black_80"
                android:textColorHint="@color/phyphox_black_60"
                android:textSize="13sp" />

            <Button
                android:id="@+id/btn_submit_inquiry_feedback"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/button_purple"
                android:text="Submit Inquiry"
                android:textAllCaps="false"
                android:textColor="@color/phyphox_white_100"
                android:textSize="13sp"
                android:textStyle="bold" />

            <ScrollView
                android:id="@+id/sv_inquiry_feedback_result"
                android:layout_width="match_parent"
                android:layout_height="100dp"
                android:layout_marginTop="8dp"
                android:background="#EEF3FF"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tv_inquiry_feedback_result"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="10dp"
                    android:textColor="@color/phyphox_black_80"
                    android:textSize="12sp" />
            </ScrollView>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- Large Drawing Area Container -->
    <androidx.cardview.widget.CardView
        android:id="@+id/drawing_container"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_margin="8dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="8dp"
        app:cardBackgroundColor="@color/phyphox_white_100"
        app:layout_constraintTop_toBottomOf="@id/inquiry_input_card"
        app:layout_constraintBottom_toTopOf="@id/bottom_toolbar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Drawing pad with screenshot background -->
        <LinearLayout
            android:id="@+id/iv_screenshot"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            tools:background="@drawable/iv_answer"
            android:gravity="bottom"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/view_drawing_pad"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal" />
        </LinearLayout>

        <!-- Color Picker Overlay -->
        <LinearLayout
            android:id="@+id/color_picker_overlay"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:layout_margin="16dp"
            android:background="@drawable/bg_button_group"
            android:orientation="vertical"
            android:padding="8dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🎨 Pilih Warna"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/phyphox_purple"
                android:layout_marginBottom="8dp"
                android:gravity="center" />

            <!-- Color Buttons Row 1 -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="4dp">

                <View
                    android:id="@+id/color_black"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_marginEnd="4dp"
                    android:background="@drawable/color_selector_black"
                    android:tag="#000000" />

                <View
                    android:id="@+id/color_red"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_marginEnd="4dp"
                    android:background="@drawable/color_selector_red"
                    android:tag="#FF0000" />

                <View
                    android:id="@+id/color_blue"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_marginEnd="4dp"
                    android:background="@drawable/color_selector_blue"
                    android:tag="#0000FF" />

                <View
                    android:id="@+id/color_green"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="@drawable/color_selector_green"
                    android:tag="#00FF00" />

            </LinearLayout>

            <!-- Color Buttons Row 2 -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <View
                    android:id="@+id/color_orange"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_marginEnd="4dp"
                    android:background="@drawable/color_selector_orange"
                    android:tag="#FF9800" />

                <View
                    android:id="@+id/color_purple"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_marginEnd="4dp"
                    android:background="@drawable/color_selector_purple"
                    android:tag="#9C27B0" />

                <View
                    android:id="@+id/color_pink"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_marginEnd="4dp"
                    android:background="@drawable/color_selector_pink"
                    android:tag="#E91E63" />

                <View
                    android:id="@+id/color_brown"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="@drawable/color_selector_brown"
                    android:tag="#795548" />

            </LinearLayout>

        </LinearLayout>

        <!-- Drawing Tools Floating Panel -->
        <LinearLayout
            android:id="@+id/floating_tools"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:layout_margin="8dp"
            android:background="@drawable/bg_button_group"
            android:orientation="horizontal"
            android:padding="4dp">

            <!-- Color Picker Toggle -->
            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/fab_color_picker"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="4dp"
                app:backgroundTint="@color/phyphox_magenta"
                android:src="@drawable/ic_palette"
                app:fabSize="mini" />

            <!-- Current Color Indicator -->
            <View
                android:id="@+id/current_color_indicator"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_gravity="center_vertical"
                android:background="@drawable/color_indicator_black"
                android:layout_marginEnd="4dp" />

            <!-- Undo -->
            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/fab_undo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="4dp"
                app:backgroundTint="@color/phyphox_purple"
                android:src="@drawable/ic_undo"
                app:fabSize="mini" />

            <!-- Redo -->
            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/fab_redo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:backgroundTint="@color/phyphox_purple"
                android:src="@drawable/ic_redo"
                app:fabSize="mini" />

            <!-- Tulis (Text Input) -->
            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/fab_tulis"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                app:backgroundTint="@color/phyphox_orange"
                android:src="@drawable/ic_keyboard"
                app:fabSize="mini"
                android:contentDescription="Tulis" />

        </LinearLayout>

        <!-- Text Note Overlay (shown when fab_tulis is clicked) -->
        <LinearLayout
            android:id="@+id/tulis_overlay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:background="#F0FFFFFF"
            android:orientation="vertical"
            android:padding="8dp"
            android:visibility="gone">

            <EditText
                android:id="@+id/et_tulis"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/custom_edittext_background_2"
                android:hint="Tulis catatan atau deskripsi analisis Anda..."
                android:inputType="textMultiLine|textCapSentences"
                android:maxLines="3"
                android:minLines="2"
                android:padding="10dp"
                android:textColor="@color/phyphox_black_100"
                android:textColorHint="@color/phyphox_black_60"
                android:textSize="13sp" />

        </LinearLayout>

    </androidx.cardview.widget.CardView>

    <!-- Compact Bottom Toolbar -->
    <androidx.cardview.widget.CardView
        android:id="@+id/bottom_toolbar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="4dp"
        app:cardCornerRadius="12dp"
        app:cardElevation="4dp"
        app:cardBackgroundColor="@color/phyphox_white_100"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingTop="6dp"
            android:paddingEnd="8dp"
            android:paddingBottom="6dp"
            android:gravity="center_vertical">

            <!-- Clear Button -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">

                <com.google.android.material.floatingactionbutton.FloatingActionButton
                    android:id="@+id/fab_clear"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:backgroundTint="@color/phyphox_orange"
                    android:src="@drawable/ic_delete_outline"
                    app:fabSize="mini" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Hapus"
                    android:textSize="9sp"
                    android:textColor="@color/phyphox_black_60" />

            </LinearLayout>

            <!-- Calculator Button -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">

                <com.google.android.material.floatingactionbutton.FloatingActionButton
                    android:id="@+id/fab_calculator"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:backgroundTint="@color/phyphox_blue_60"
                    android:src="@drawable/ic_calculator"
                    app:fabSize="mini" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Kalkulator"
                    android:textSize="9sp"
                    android:textColor="@color/phyphox_black_60" />

            </LinearLayout>

            <!-- Next Button -->
            <Button
                android:id="@+id/fab_next"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="3"
                android:layout_marginStart="10dp"
                android:text="Next"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textAllCaps="false"
                android:background="@drawable/btn_next_selector"
                android:textColor="@color/btn_next_text_selector" />

        </LinearLayout>

    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>
