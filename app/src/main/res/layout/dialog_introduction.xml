<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:fillViewport="true">

    <LinearLayout
        android:orientation="vertical"
        android:padding="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:id="@+id/tvClose"
            android:layout_gravity="end"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tutup"
            android:paddingHorizontal="16dp"
            android:paddingVertical="8dp"
            android:textColor="@color/phyphox_white_100"
            android:background="@drawable/background_8_black"
            android:textSize="18sp" />

        <TextView
            android:layout_marginTop="16dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="• What is centripetal acceleration activities?"
            android:textSize="18sp"
            android:textColor="#8F0D53"
            android:textStyle="bold" />

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:layout_marginTop="8dp"
            android:src="@drawable/image_circle"
            android:scaleType="centerCrop" />
        <ImageView
            android:id="@+id/tv_see"
            android:layout_width="200dp"
            android:layout_height="167dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/image_parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/iv_circle" />

        <ImageView
            android:id="@+id/tv_understand"
            android:layout_width="255dp"
            android:layout_height="200dp"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="16dp"
            android:background="@drawable/image_ballet"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_see" />

        <TextView
            android:id="@+id/iv_four"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="•What is angular velocity?"
            android:textColor="#8F0D53"
            android:textSize="18sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_understand" />

        <TextView
            android:id="@+id/tv_rotating"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="How fast is an object rotating?\nWe define angular velocity (w) as the rate of change of an angle."
            app:layout_constraintEnd_toEndOf="@id/iv_four"
            app:layout_constraintStart_toStartOf="@id/iv_four"
            app:layout_constraintTop_toBottomOf="@id/iv_four" />

        <ImageView
            android:id="@+id/iv_rotating"
            android:layout_width="288dp"
            android:layout_height="236dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/image_rotating"
            app:layout_constraintTop_toBottomOf="@id/tv_rotating"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <ImageView
            android:id="@+id/iv_rumus"
            android:layout_width="135dp"
            android:layout_height="72dp"
            android:background="@drawable/image_rumus"
            app:layout_constraintTop_toBottomOf="@id/iv_rotating"
            app:layout_constraintEnd_toEndOf="@id/iv_rotating" />

        <TextView
            android:id="@+id/tv_explain"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:textSize="18sp"
            android:textColor="#3D2FE0"
            android:textStyle="bold"
            android:text="Figure Explanation :"
            app:layout_constraintTop_toBottomOf="@id/iv_rumus"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/radius"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="• Radius (r): The distance from the center of the circle to any point on its circumference. \n• Angle (Δθ): The measure of rotation between two radii of the circle.\n• Arc Length (Δs): The distance traveled along the circular path."
            app:layout_constraintTop_toBottomOf="@id/tv_explain"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/tv_wdeg"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="w (deg/s)"
            android:layout_marginTop="8dp"
            app:layout_constraintTop_toBottomOf="@id/radius"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <ImageView
            android:id="@+id/iv_ideg"
            android:layout_width="379dp"
            android:layout_height="317dp"
            android:background="@drawable/image_deg"
            app:layout_constraintTop_toBottomOf="@id/tv_wdeg"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/tv_illustrated"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="This graph illustrates how angular velocity (w) changes over time (t). Notice the decrease from 20 deg/s to 10 deg/s between 2 and 3 seconds, showing how the rotation slows down."
            app:layout_constraintTop_toBottomOf="@id/iv_ideg"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <ImageView
            android:id="@+id/iv_centripental"
            android:layout_width="380dp"
            android:layout_height="270dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/centripental"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_illustrated" />

        <ImageView
            android:id="@+id/iv_circular"
            android:layout_width="340dp"
            android:layout_height="280dp"
            android:background="@drawable/circular"
            app:layout_constraintTop_toBottomOf="@id/iv_centripental"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/tv_experiment"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:text="You want to experience it to yourself?"
            android:textSize="18sp"
            android:textColor="#6F0909"
            android:layout_marginTop="16dp"
            android:textStyle="bold"
            app:layout_constraintTop_toBottomOf="@id/iv_circular"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/tv_description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="This app will record your activities related to  angular movement using sensors,  providing a personalized and immersive learning  experience !"
            app:layout_constraintTop_toBottomOf="@id/tv_experiment"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <ImageView
            android:id="@+id/iv_try"
            android:layout_width="336dp"
            android:layout_height="159dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/image_try"
            app:layout_constraintTop_toBottomOf="@id/tv_description"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </LinearLayout>
</ScrollView>
