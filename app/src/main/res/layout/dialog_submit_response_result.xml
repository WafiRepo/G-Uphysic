<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="@drawable/rounded_dialog">

    <TextView
        android:id="@+id/tv_result_icon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginBottom="8dp"
        android:textSize="40sp" />

    <TextView
        android:id="@+id/tv_result_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginBottom="12dp"
        android:textColor="@color/phyphox_purple"
        android:textSize="20sp"
        android:textStyle="bold" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxHeight="280dp">

        <TextView
            android:id="@+id/tv_result_message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/phyphox_white_90"
            android:padding="16dp"
            android:textColor="@color/phyphox_black_80"
            android:textSize="15sp"
            android:lineSpacingExtra="4dp" />
    </ScrollView>

    <Button
        android:id="@+id/btn_result_ok"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:backgroundTint="@color/phyphox_purple"
        android:text="Mengerti"
        android:textColor="@color/phyphox_white_100" />
</LinearLayout>
