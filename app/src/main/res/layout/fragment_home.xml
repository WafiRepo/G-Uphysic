<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#6223A9"
    android:theme="@style/Theme.MaterialComponents.NoActionBar"
    tools:context=".fragment.HomeFragment">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#6223A9">

    <ImageView
        android:id="@+id/iv_sunny"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:src="@drawable/ic_sunny"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="#FFD6DD" />

    <TextView
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="8dp"
        android:text="GOOD MORNING"
        android:textColor="#FFD6DD"
        app:layout_constraintBottom_toBottomOf="@id/iv_sunny"
        app:layout_constraintEnd_toStartOf="@id/iv_profile"
        app:layout_constraintStart_toEndOf="@id/iv_sunny"
        app:layout_constraintTop_toTopOf="@id/iv_sunny" />

    <ImageView
        android:visibility="invisible"
        android:id="@+id/iv_profile"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/ic_avatar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvName"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:gravity="center_vertical"
        android:text="Vinsa Kharisma"
        android:textSize="20dp"
        android:textColor="@color/phyphox_white_100"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="@id/iv_profile"
        app:layout_constraintEnd_toStartOf="@id/iv_profile"
        app:layout_constraintStart_toStartOf="@id/iv_sunny"
        app:layout_constraintTop_toBottomOf="@id/iv_sunny" />

    <ImageView
        android:id="@+id/iv_card"
        android:layout_width="0dp"
        android:layout_height="240dp"
        android:scaleType="centerCrop"
        android:layout_marginTop="24dp"
        android:background="@drawable/card_home"
        app:layout_constraintEnd_toEndOf="@id/iv_profile"
        app:layout_constraintStart_toStartOf="@id/iv_sunny"
        app:layout_constraintTop_toBottomOf="@id/iv_profile" />

    <View
        android:id="@+id/v_sheet"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="24dp"
        android:background="@drawable/bg_sheet"
        app:layout_constraintTop_toBottomOf="@id/iv_card"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />
    <TextView
        android:id="@+id/tv_quiz"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="24dp"
        android:text="Activity"
        android:textColor="@color/phyphox_black_80"
        android:textSize="20dp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="@id/v_sheet"
        app:layout_constraintEnd_toStartOf="@id/tv_see_all"
        app:layout_constraintStart_toStartOf="@id/v_sheet"
        app:layout_constraintTop_toTopOf="@id/v_sheet" />
    <LinearLayout
        android:id="@+id/llQuiz"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"

        android:orientation="vertical"
        app:layout_constraintTop_toBottomOf="@+id/tv_quiz">

        <RelativeLayout
            android:id="@+id/rlInClass"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_card"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:text="In Class"
                android:textColor="@color/phyphox_black_80"
                android:textSize="20sp"
                android:textStyle="bold" />

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_alignParentEnd="true"
                android:layout_centerHorizontal="true"
                android:background="@drawable/ic_next" />

        </RelativeLayout>

        <RelativeLayout
            android:id="@+id/rlOutClass"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_card"
            android:padding="16dp">

            <TextView
                android:layout_centerVertical="true"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Out Of Class"
                android:textColor="@color/phyphox_black_80"
                android:textSize="20sp"
                android:textStyle="bold" />

            <ImageView
                android:layout_centerVertical="true"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_alignParentEnd="true"
                android:layout_centerHorizontal="true"
                android:background="@drawable/ic_next" />

        </RelativeLayout>
    </LinearLayout>
    <TextView
        android:visibility="gone"
        android:id="@+id/tv_topics"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Topics"
        android:layout_marginTop="24dp"
        android:layout_marginHorizontal="16dp"
        android:textSize="20dp"
        android:textStyle="bold"
        android:textColor="@color/phyphox_black_80"
        app:layout_constraintEnd_toStartOf="@id/tv_see_all"
        app:layout_constraintTop_toBottomOf="@+id/llQuiz"
        app:layout_constraintStart_toStartOf="@id/v_sheet"
        app:layout_constraintEnd_toEndOf="@id/v_sheet" />

    <TextView
        android:visibility="gone"
        android:id="@+id/tv_see_all"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="See all"
        android:textStyle="bold"
        android:textColor="#6A5AE0"
        android:layout_marginEnd="16dp"
        app:layout_constraintTop_toTopOf="@id/tv_topics"
        app:layout_constraintBottom_toBottomOf="@id/tv_topics"
        app:layout_constraintEnd_toEndOf="@id/v_sheet" />

    <View
        android:visibility="gone"
        android:id="@+id/iv_card_1"
        android:layout_width="0dp"
        android:layout_height="96dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_card"
        app:layout_constraintStart_toStartOf="@id/tv_topics"
        app:layout_constraintEnd_toEndOf="@id/tv_see_all"
        app:layout_constraintTop_toBottomOf="@id/iv_card_2"/>

    <ImageView
        android:visibility="gone"
        android:id="@+id/iv_next_1"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:background="@drawable/ic_next"
        android:layout_marginEnd="16dp"
        app:layout_constraintTop_toTopOf="@id/iv_card_1"
        app:layout_constraintEnd_toEndOf="@id/iv_card_1"
        app:layout_constraintBottom_toBottomOf="@id/iv_card_1" />

    <TextView
        android:visibility="gone"
        android:id="@+id/tv_linear"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Centripetal Movement"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_marginTop="16dp"
        android:textColor="@color/phyphox_black_80"
        android:layout_marginStart="16dp"
        app:layout_constraintStart_toStartOf="@id/iv_card_1"
        app:layout_constraintTop_toTopOf="@id/iv_card_1"
        app:layout_constraintEnd_toStartOf="@id/iv_next_1" />

    <TextView
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Senior High School Student"
        android:textSize="16sp"
        android:textStyle="bold"
        android:layout_marginTop="8dp"
        android:textColor="@color/phyphox_black_80"
        android:layout_marginStart="16dp"
        app:layout_constraintStart_toStartOf="@id/iv_card_1"
        app:layout_constraintTop_toBottomOf="@id/tv_linear"
        app:layout_constraintEnd_toEndOf="@id/tv_linear" />

    <View
        android:visibility="gone"
        android:id="@+id/iv_card_2"
        android:layout_width="0dp"
        android:layout_height="96dp"
        android:layout_marginTop="24dp"
        android:background="@drawable/bg_card"
        app:layout_constraintStart_toStartOf="@id/tv_topics"
        app:layout_constraintEnd_toEndOf="@id/tv_see_all"
        app:layout_constraintTop_toBottomOf="@id/tv_topics" />

    <ImageView
        android:visibility="gone"
        android:id="@+id/iv_next_2"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:background="@drawable/ic_next"
        android:layout_marginEnd="16dp"
        app:layout_constraintTop_toTopOf="@id/iv_card_2"
        app:layout_constraintEnd_toEndOf="@id/iv_card_2"
        app:layout_constraintBottom_toBottomOf="@id/iv_card_2" />

    <TextView
        android:visibility="gone"
        android:id="@+id/tv_linear_2"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Linier Movement"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="@color/phyphox_black_80"
        android:layout_marginTop="16dp"
        android:layout_marginStart="16dp"
        app:layout_constraintStart_toStartOf="@id/iv_card_2"
        app:layout_constraintTop_toTopOf="@id/iv_card_2"
        app:layout_constraintEnd_toStartOf="@id/iv_next_2" />

    <TextView
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Junior High School Student"
        android:textSize="16sp"
        android:textStyle="bold"
        android:layout_marginTop="8dp"
        android:layout_marginStart="16dp"
        android:textColor="@color/phyphox_black_80"
        app:layout_constraintStart_toStartOf="@id/iv_card_2"
        app:layout_constraintTop_toBottomOf="@id/tv_linear_2"
        app:layout_constraintEnd_toEndOf="@id/tv_linear_2" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
