<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/gradient_background"
    android:theme="@style/Theme.Material3.Dark.NoActionBar"
    tools:context=".fragment.ShareLocationFragment">

    <!-- Header with back button and settings -->
    <LinearLayout
        android:id="@+id/header_layout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="center_vertical"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/back_button"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_arrow_back"
            android:padding="4dp"
            android:contentDescription="Kembali" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <ImageView
            android:id="@+id/iv_setting"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_settings"
            android:padding="4dp"
            android:contentDescription="Pengaturan" />

    </LinearLayout>

    <!-- Background View for Content -->
    <View
        android:id="@+id/sheet"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginHorizontal="8dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_sheet"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/header_layout" />

    <!-- Camera Container -->
    <FrameLayout
        android:id="@+id/camera_container"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_margin="16dp"
        app:layout_constraintBottom_toTopOf="@id/btn_save"
        app:layout_constraintEnd_toEndOf="@id/sheet"
        app:layout_constraintStart_toStartOf="@id/sheet"
        app:layout_constraintTop_toTopOf="@id/sheet">

        <org.opencv.android.JavaCameraView
            android:id="@+id/cameraview"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <ImageView
            android:id="@+id/capturedImageView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:visibility="gone" />

        <!-- Area pertanyaan + instruksi kamera (lebih menonjol dan user-friendly) -->
        <androidx.cardview.widget.CardView
            android:id="@+id/inquiry_overlay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:visibility="visible"
            app:cardBackgroundColor="#F8F7FC"
            app:cardCornerRadius="12dp"
            app:cardElevation="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Pertanyaan (What can you find...) - lebih besar dan warna ungu -->
                <TextView
                    android:id="@+id/tv_inquiry_overlay"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/phyphox_purple"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:lineSpacingExtra="4dp"
                    android:gravity="center"
                    android:visibility="gone" />

                <!-- Instruksi kamera (Point the camera...) - lebih kecil, warna abu -->
                <TextView
                    android:id="@+id/tv_instruction_below_inquiry"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="2dp"
                    android:text="Point the camera at the object until a green circle automatically appears along with its variables."
                    android:textColor="#6B6B7B"
                    android:textSize="13sp"
                    android:gravity="center" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>
    </FrameLayout>

    <!-- Capture Button for Taking Photos -->
    <ImageButton
        android:id="@+id/captureButton"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:layout_marginBottom="20dp"
        android:background="@drawable/btn_capture_selector"
        android:src="@drawable/ic_camera"
        android:padding="16dp"
        android:elevation="8dp"
        android:contentDescription="Ambil foto"
        app:layout_constraintBottom_toTopOf="@id/btn_save"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <androidx.cardview.widget.CardView
        android:id="@+id/cardResult"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="32dp"
        android:layout_marginTop="8dp"
        app:cardBackgroundColor="@color/phyphox_white_100"
        app:cardCornerRadius="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/camera_container">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp">

            <!-- Judul di atas kolom label -->
            <TextView
                android:id="@+id/tvLabelTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Objek yang Terdeteksi"
                android:textStyle="bold"
                android:textColor="@color/phyphox_purple"
                android:textSize="18sp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_marginBottom="12dp"/>

            <EditText
                android:textAlignment="center"
                android:padding="16dp"
                android:background="@drawable/background_white_border_primary_8"
                android:id="@+id/tvLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Label"
                android:textColor="@color/phyphox_black_100"
                android:textSize="16sp"
                android:enabled="false"
                app:layout_constraintTop_toBottomOf="@id/tvLabelTitle" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="16dp"
                app:layout_constraintTop_toBottomOf="@id/tvLabel">

                <Button
                    android:id="@+id/tvEdit"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:text="✏️ Edit"
                    android:textAllCaps="false"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:background="@drawable/btn_level_selector"
                    android:textColor="@color/phyphox_purple" />

                <Button
                    android:id="@+id/tvOkay"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:text="✅ OK"
                    android:textAllCaps="false"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:background="@drawable/btn_next_selector"
                    android:textColor="@color/phyphox_white_100"
                    android:enabled="false" />

            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.cardview.widget.CardView>

    <!-- Save Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_upload"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginBottom="16dp"
        android:backgroundTint="@color/phyphox_purple"
        android:text="💾 Simpan"
        android:textColor="@color/phyphox_white_100"
        app:layout_constraintBottom_toBottomOf="@id/sheet"
        app:layout_constraintStart_toStartOf="@id/sheet" />

    <!-- Next Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_save"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/btn_next_selector"
        android:enabled="false"
        android:text="➡️ Selanjutnya"
        android:textColor="@color/btn_next_text_selector"
        app:layout_constraintBottom_toBottomOf="@id/sheet"
        app:layout_constraintEnd_toEndOf="@id/sheet" />

</androidx.constraintlayout.widget.ConstraintLayout>
