<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/gradient_background"
    tools:context=".activity.GeneratesActivity">

    <!-- Top Header -->
    <androidx.cardview.widget.CardView
        android:id="@+id/header_card"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="8dp"
        app:cardBackgroundColor="@color/phyphox_white_100"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="20dp"
            android:gravity="center_vertical">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/btn_generates"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🤖 Soal AI-Generated"
                    android:textColor="@color/phyphox_purple"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Soal fisika yang dibuat khusus untuk Anda"
                    android:textColor="@color/phyphox_black_60"
                    android:textSize="14sp" />

            </LinearLayout>

            <!-- Info Button -->
            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/ivSign"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                app:backgroundTint="@color/phyphox_black_100"
                android:src="@drawable/knowledge"
                app:fabSize="mini"
                android:contentDescription="Panduan" />

        </LinearLayout>

    </androidx.cardview.widget.CardView>

    <!-- Main Content -->
    <androidx.cardview.widget.CardView
        android:id="@+id/main_content_card"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_margin="16dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="4dp"
        app:cardBackgroundColor="@color/phyphox_white_100"
        app:layout_constraintTop_toBottomOf="@id/header_card"
        app:layout_constraintBottom_toTopOf="@id/bottom_actions"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ScrollView
            android:id="@+id/scroll_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="16dp"
            android:scrollbars="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center">

                <!-- Question Section -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="2dp"
                    app:cardBackgroundColor="#F0F8FF">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="12dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="❓"
                                android:textSize="20sp" />

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginStart="8dp"
                                android:text="Soal Untuk Anda"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                android:textColor="@color/phyphox_purple" />

                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvQuestion"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_button_group"
                            android:text="Memuat soal..."
                            android:textSize="15sp"
                            android:gravity="center"
                            android:padding="16dp"
                            android:textColor="@color/phyphox_black_100"
                            android:lineSpacingExtra="4dp" />

                        <EditText
                            android:id="@+id/etQuestion"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:background="@drawable/custom_edittext_background_2"
                            android:hint="Input Questions"
                            android:minLines="8"
                            android:padding="16dp"
                            android:textColor="@color/phyphox_black_100"
                            android:textColorHint="@color/phyphox_white_50_black_50"
                            android:textSize="16sp"
                            android:visibility="gone" />

                    </LinearLayout>

                </androidx.cardview.widget.CardView>

                <!-- Graph/Image Section -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/graph_section"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="2dp"
                    app:cardBackgroundColor="#F8F9FA">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="12dp">

<!--                            <TextView-->
<!--                                android:layout_width="wrap_content"-->
<!--                                android:layout_height="wrap_content"-->
<!--                                android:text="📊"-->
<!--                                android:textSize="20sp" />-->

<!--                            <TextView-->
<!--                                android:layout_width="0dp"-->
<!--                                android:layout_height="wrap_content"-->
<!--                                android:layout_weight="1"-->
<!--                                android:layout_marginStart="8dp"-->
<!--                                android:text="Grafik &amp; Diagram"-->
<!--                                android:textSize="16sp"-->
<!--                                android:textStyle="bold"-->
<!--                                android:textColor="@color/phyphox_purple" />-->

                        </LinearLayout>

                        <!-- Main Graph/Diagram Image -->
                        <com.github.chrisbanes.photoview.PhotoView
                            android:id="@+id/iv"
                            android:layout_width="match_parent"
                            android:layout_height="300dp"
                            android:scaleType="fitCenter"
                            android:background="@drawable/bg_button_group"
                            android:visibility="gone" />

                        <!-- Additional Image -->
                        <com.github.chrisbanes.photoview.PhotoView
                            android:id="@+id/iv2"
                            android:layout_width="match_parent"
                            android:layout_height="300dp"
                            android:layout_marginTop="16dp"
                            android:scaleType="fitCenter"
                            android:background="@drawable/bg_button_group"
                            android:visibility="gone" />

                        <!-- Table Images Container -->
                        <LinearLayout
                            android:id="@+id/table_images_container"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:orientation="vertical"
                            android:visibility="gone">

                            <!-- Table Image 1 -->
                            <com.github.chrisbanes.photoview.PhotoView
                                android:id="@+id/iv3"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:minHeight="200dp"
                                android:maxHeight="400dp"
                                android:adjustViewBounds="true"
                                android:scaleType="fitCenter"
                                android:background="@drawable/bg_button_group"
                                android:visibility="gone"
                                android:contentDescription="Table Image 1 with enhanced zoom" />

                            <!-- Table Image 2 -->
                            <com.github.chrisbanes.photoview.PhotoView
                                android:id="@+id/iv4"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:minHeight="200dp"
                                android:maxHeight="400dp"
                                android:layout_marginTop="8dp"
                                android:adjustViewBounds="true"
                                android:scaleType="fitCenter"
                                android:background="@drawable/bg_button_group"
                                android:visibility="gone"
                                android:contentDescription="Table Image 2 with enhanced zoom" />

                        </LinearLayout>

                        <!-- Additional Image 2 -->
                        <com.github.chrisbanes.photoview.PhotoView
                            android:id="@+id/iv5"
                            android:layout_width="match_parent"
                            android:layout_height="300dp"
                            android:layout_marginTop="16dp"
                            android:scaleType="fitCenter"
                            android:background="@drawable/bg_button_group"
                            android:visibility="gone" />

                        <com.github.chrisbanes.photoview.PhotoView
                            android:id="@+id/ivDraw"
                            android:layout_width="match_parent"
                            android:layout_height="200dp"
                            android:layout_marginTop="8dp"
                            android:scaleType="fitCenter"
                            android:background="@drawable/bg_button_group"
                            android:visibility="gone" />

                        <!-- Current Color Indicator -->
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="end"
                            android:layout_marginTop="8dp"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Warna:"
                                android:textSize="12sp"
                                android:textColor="@color/phyphox_black_60"
                                android:layout_marginEnd="8dp" />

                            <View
                                android:id="@+id/current_color_indicator"
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:background="@drawable/color_indicator_black" />

                        </LinearLayout>

                    </LinearLayout>

                </androidx.cardview.widget.CardView>

                <!-- Color Picker Overlay -->
                <LinearLayout
                    android:id="@+id/color_picker_overlay"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|end"
                    android:layout_margin="16dp"
                    android:background="@drawable/bg_button_group"
                    android:orientation="vertical"
                    android:padding="8dp"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🎨 Pilih Warna"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="@color/phyphox_purple"
                        android:layout_marginBottom="8dp"
                        android:gravity="center" />

                    <!-- Color Buttons Row 1 -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="4dp">

                        <View
                            android:id="@+id/color_black"
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:layout_marginEnd="4dp"
                            android:background="@drawable/color_selector_black"
                            android:tag="#000000" />

                        <View
                            android:id="@+id/color_red"
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:layout_marginEnd="4dp"
                            android:background="@drawable/color_selector_red"
                            android:tag="#FF0000" />

                        <View
                            android:id="@+id/color_blue"
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:layout_marginEnd="4dp"
                            android:background="@drawable/color_selector_blue"
                            android:tag="#0000FF" />

                        <View
                            android:id="@+id/color_green"
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:background="@drawable/color_selector_green"
                            android:tag="#00FF00" />

                    </LinearLayout>

                    <!-- Color Buttons Row 2 -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <View
                            android:id="@+id/color_orange"
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:layout_marginEnd="4dp"
                            android:background="@drawable/color_selector_orange"
                            android:tag="#FF9800" />

                        <View
                            android:id="@+id/color_purple"
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:layout_marginEnd="4dp"
                            android:background="@drawable/color_selector_purple"
                            android:tag="#9C27B0" />

                        <View
                            android:id="@+id/color_pink"
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:layout_marginEnd="4dp"
                            android:background="@drawable/color_selector_pink"
                            android:tag="#E91E63" />

                        <View
                            android:id="@+id/color_brown"
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:background="@drawable/color_selector_brown"
                            android:tag="#795548" />

                    </LinearLayout>

                </LinearLayout>

                <!-- Photo Section -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="2dp"
                    app:cardBackgroundColor="#FFF8F0">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="12dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="📸"
                                android:textSize="20sp" />

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginStart="8dp"
                                android:text="Dokumentasi Catatan"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                android:textColor="@color/phyphox_purple" />

                            <Button
                                android:id="@+id/btnTakePhoto"
                                android:layout_width="wrap_content"
                                android:layout_height="40dp"
                                android:text="📷 Ambil Foto"
                                android:textSize="12sp"
                                android:textAllCaps="false"
                                android:background="@drawable/btn_next_selector"
                                android:textColor="@color/phyphox_white_100"
                                android:paddingHorizontal="16dp" />

                        </LinearLayout>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="💡 Ambil foto catatan Anda untuk melengkapi jawaban"
                            android:textSize="12sp"
                            android:textColor="@color/phyphox_black_60"
                            android:layout_marginBottom="8dp" />

                        <!-- Photo Documentation Preview -->
                        <LinearLayout
                            android:id="@+id/llDocumentationPhoto"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:visibility="gone">
                            
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="📸 Foto Dokumentasi:"
                                android:textColor="@color/phyphox_purple"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                android:layout_marginBottom="8dp"/>
                            
                            <com.github.chrisbanes.photoview.PhotoView
                                android:id="@+id/ivDocumentationPhoto"
                                android:layout_width="match_parent"
                                android:layout_height="200dp"
                                android:scaleType="fitCenter"
                                android:background="@drawable/custom_edittext_background_2"
                                android:padding="4dp"
                                android:layout_marginBottom="8dp"/>
                        </LinearLayout>

                    </LinearLayout>

                </androidx.cardview.widget.CardView>

                <!-- Drawing Tools & Canvas Section -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="2dp"
                    app:cardBackgroundColor="#F0FFF0">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="12dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="✏️"
                                android:textSize="20sp" />

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginStart="8dp"
                                android:text="Area Menggambar"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                android:textColor="@color/phyphox_purple" />

                            <com.google.android.material.floatingactionbutton.FloatingActionButton
                                android:id="@+id/btn_calculator"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                app:backgroundTint="@color/phyphox_blue_60"
                                android:src="@drawable/ic_calculator"
                                app:fabSize="mini"
                                android:contentDescription="Kalkulator" />

                            <com.google.android.material.floatingactionbutton.FloatingActionButton
                                android:id="@+id/btnType"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                app:backgroundTint="@color/phyphox_orange"
                                android:src="@drawable/ic_keyboard"
                                app:fabSize="mini"
                                android:contentDescription="Input Tipe" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:text="ketik"
                                android:textSize="10sp"
                                android:textColor="@color/phyphox_black_60" />

                        </LinearLayout>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="💡 Gambar diagram, perhitungan, atau analisis Anda di area ini"
                            android:textSize="12sp"
                            android:textColor="@color/phyphox_black_60"
                            android:layout_marginBottom="8dp" />

                        <!-- Drawing Tools -->
                        <LinearLayout
                            android:id="@+id/button_container"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center"
                            android:layout_marginBottom="12dp"
                            android:background="@drawable/bg_button_group"
                            android:padding="8dp">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical"
                                android:gravity="center">

                                <com.google.android.material.floatingactionbutton.FloatingActionButton
                                    android:id="@+id/btn_undo"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:contentDescription="Undo"
                                    app:srcCompat="@drawable/ic_undo"
                                    app:backgroundTint="@color/phyphox_purple"
                                    android:tint="@color/phyphox_white_100"
                                    app:fabSize="mini" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="4dp"
                                    android:text="Undo"
                                    android:textSize="10sp"
                                    android:textColor="@color/phyphox_black_60" />

                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical"
                                android:gravity="center">

                                <com.google.android.material.floatingactionbutton.FloatingActionButton
                                    android:id="@+id/btn_redo"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:contentDescription="Redo"
                                    app:srcCompat="@drawable/ic_redo"
                                    app:backgroundTint="@color/phyphox_purple"
                                    android:tint="@color/phyphox_white_100"
                                    app:fabSize="mini" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="4dp"
                                    android:text="Redo"
                                    android:textSize="10sp"
                                    android:textColor="@color/phyphox_black_60" />

                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical"
                                android:gravity="center">

                                <com.google.android.material.floatingactionbutton.FloatingActionButton
                                    android:id="@+id/btn_clear"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:contentDescription="Clear"
                                    app:srcCompat="@drawable/ic_delete_outline"
                                    app:backgroundTint="@color/phyphox_orange"
                                    android:tint="@color/phyphox_white_100"
                                    app:fabSize="mini" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="4dp"
                                    android:text="Hapus"
                                    android:textSize="10sp"
                                    android:textColor="@color/phyphox_black_60" />

                            </LinearLayout>

                            <!-- Color Palette Button -->
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical"
                                android:gravity="center">

                                <com.google.android.material.floatingactionbutton.FloatingActionButton
                                    android:id="@+id/btn_color_palette"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:contentDescription="Color Palette"
                                    app:srcCompat="@drawable/ic_palette"
                                    app:backgroundTint="@color/phyphox_magenta"
                                    android:tint="@color/phyphox_white_100"
                                    app:fabSize="mini" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="4dp"
                                    android:text="Warna"
                                    android:textSize="10sp"
                                    android:textColor="@color/phyphox_black_60" />

                            </LinearLayout>

                        </LinearLayout>

                        <!-- Hidden Elements Still Needed by Java Code -->
                        <EditText
                            android:id="@+id/tvType"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="8dp"
                            android:background="@drawable/custom_edittext_background_2"
                            android:hint="Input Tipe (Opsional)"
                            android:padding="12dp"
                            android:textColor="@color/phyphox_black_100"
                            android:textColorHint="@color/phyphox_black_60"
                            android:textSize="14sp"
                            android:visibility="gone" />



                        <!-- Drawing Canvas -->
                        <LinearLayout
                            android:id="@+id/llDraw"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <de.rwth_aachen.phyphox.activity.DrawView
                                android:id="@+id/drawView"
                                android:layout_width="match_parent"
                                android:layout_height="600dp"
                                android:background="#FFFEF7"
                                android:layout_margin="8dp" />

                        </LinearLayout>

                    </LinearLayout>

                </androidx.cardview.widget.CardView>

            </LinearLayout>

        </ScrollView>

    </androidx.cardview.widget.CardView>

    <!-- Bottom Actions -->
    <androidx.cardview.widget.CardView
        android:id="@+id/bottom_actions"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        app:cardCornerRadius="12dp"
        app:cardElevation="4dp"
        app:cardBackgroundColor="@color/phyphox_white_100"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="16dp"
            android:gravity="center_vertical">

            <Button
                android:id="@+id/btn_upload"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:text="💾 Simpan"
                android:textSize="14sp"
                android:textAllCaps="false"
                android:background="@drawable/btn_green_selector"
                android:textColor="@color/phyphox_white_100" />

            <Button
                android:id="@+id/btn_save"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="▶️ Lanjutkan"
                android:textSize="14sp"
                android:textAllCaps="false"
                android:background="@drawable/btn_next_selector"
                android:textColor="@color/phyphox_white_100" />

        </LinearLayout>

    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>
