<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    app:cardCornerRadius="16dp"
    android:background="@color/phyphox_white_100"
    app:cardElevation="6dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <TextView
            app:layout_constraintEnd_toEndOf="@id/llData"
            app:layout_constraintTop_toTopOf="parent"
            android:id="@+id/tvEdit"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:textSize="12dp"
            android:layout_height="wrap_content"
            android:background="@drawable/background_8_gray"
            android:text="Edit"
            android:paddingVertical="6dp"
            android:paddingHorizontal="16dp"
            android:layout_marginLeft="8dp"
            android:textColor="@android:color/black"/>
        <LinearLayout
            android:id="@+id/llData"
            app:layout_constraintEnd_toStartOf="@+id/clAction"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_width="0dp"
            app:layout_constraintTop_toTopOf="parent"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvTopic"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Centripetal Acceleration"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/phyphox_blue_60"/>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="16dp">

                <TextView
                    android:id="@+id/tvType"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/background_8_black"
                    android:text="Easy"
                    android:padding="6dp"
                    android:textColor="@android:color/white"
                    android:textStyle="bold"/>

                <TextView
                    android:id="@+id/tvStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/background_8_gray"
                    android:text="In Progress"
                    android:padding="6dp"
                    android:layout_marginLeft="8dp"
                    android:textColor="@android:color/black"/>
            </LinearLayout>
        </LinearLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="wrap_content"
            app:layout_constraintTop_toTopOf="@id/llData"
            app:layout_constraintBottom_toBottomOf="@id/llData"
            android:id="@+id/clAction"
            app:layout_constraintEnd_toStartOf="@+id/cbSelect"
            android:layout_height="0dp">
            <ImageView
                android:id="@+id/ivCompletedAction"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:background="@drawable/baseline_keyboard_arrow_right_24"
                android:layout_width="24dp"
                android:layout_height="24dp"/>
            <TextView
                android:id="@+id/tvInProgressAction"
                android:visibility="gone"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingVertical="8dp"
                android:paddingHorizontal="24dp"
                android:text="Continue"
                android:background="@drawable/background_blue"
                android:textColor="@android:color/white"
                android:textStyle="bold"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <CheckBox
            android:id="@+id/cbSelect"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:layout_gravity="center_vertical"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"/>

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.cardview.widget.CardView>
