<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingHorizontal="16dp"
    android:layout_marginVertical="16dp"
    android:theme="@style/Theme.Material3.Dark.NoActionBar"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".fragment.AngularIntroductionFragment">

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/tv_what"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="•What is linear movement activities?"
                android:textColor="#8F0D53"
                android:textSize="18sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <ImageView
                android:id="@+id/iv_circle"
                android:layout_width="335dp"
                android:layout_height="334dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/linear"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tv_what" />

            <TextView
                android:id="@+id/tv_see"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="See how a car speeds up on the track and learn about linear movement. Watch how the car's speed changes over time and understand the basics of motion with real examples."
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/iv_circle" />

            <TextView
                android:id="@+id/tv_understand"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Understand how distance and time are connected through these graphs. Visualize how speed changes over time to better grasp the concept of motion."
                android:layout_marginTop="16dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tv_see" />

            <ImageView
                android:id="@+id/iv_four"
                android:layout_width="345dp"
                android:layout_height="391dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/image_four"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tv_understand" />

            <TextView
                android:id="@+id/tv_rotating"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Understand how distance, speed, and time are related with these simple formulas. Use the triangles to easily calculate any one of these variables when you know the other two."
                app:layout_constraintEnd_toEndOf="@id/iv_four"
                app:layout_constraintStart_toStartOf="@id/iv_four"
                app:layout_constraintTop_toBottomOf="@id/iv_four" />

            <ImageView
                android:id="@+id/iv_rotating"
                android:layout_width="338dp"
                android:layout_height="245dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/image_triangle"
                app:layout_constraintTop_toBottomOf="@id/tv_rotating"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <TextView
                android:id="@+id/tv_experiment"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text="You want to experience it to yourself?"
                android:textSize="18sp"
                android:textColor="#6F0909"
                android:layout_marginTop="16dp"
                android:textStyle="bold"
                app:layout_constraintTop_toBottomOf="@id/iv_rotating"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <TextView
                android:id="@+id/tv_description"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="This app will record your activities related to  linear movement using sensors,  providing a personalized and immersive learning  experience !"
                app:layout_constraintTop_toBottomOf="@id/tv_experiment"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <ImageView
                android:id="@+id/iv_try"
                android:layout_width="334dp"
                android:layout_height="130dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/start"
                app:layout_constraintTop_toBottomOf="@id/tv_description"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_start"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Start"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="24dp"
                app:cornerRadius="8dp"
                android:textColor="@color/phyphox_white_100"
                android:backgroundTint="@color/phyphox_purple"
                app:layout_constraintTop_toBottomOf="@id/iv_try"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
