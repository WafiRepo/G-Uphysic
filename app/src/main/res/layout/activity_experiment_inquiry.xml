<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/phyphox_purple">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <ImageView
            android:id="@+id/btn_back_experiment_inquiry"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginBottom="16dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Back"
            android:padding="6dp"
            android:src="@drawable/ic_arrow_back" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginBottom="8dp"
            android:text="📊"
            android:textSize="36sp" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginBottom="24dp"
            android:text="Analyze your data"
            android:textColor="@color/phyphox_white_100"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="Pertanyaan"
            android:textColor="@color/phyphox_white_100"
            android:textSize="14sp"
            android:textStyle="bold" />
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            app:cardBackgroundColor="#D4EDDA"
            app:cardCornerRadius="16dp"
            app:cardElevation="6dp">
            <TextView
                android:id="@+id/tv_experiment_inquiry_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="20dp"
                android:textColor="@color/phyphox_black_80"
                android:textSize="16sp"
                android:lineSpacingExtra="6dp" />
        </androidx.cardview.widget.CardView>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="Jawaban Anda"
            android:textColor="@color/phyphox_white_100"
            android:textSize="14sp"
            android:textStyle="bold" />
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            app:cardBackgroundColor="#E8E4F3"
            app:cardCornerRadius="16dp"
            app:cardElevation="6dp">
            <EditText
                android:id="@+id/et_experiment_user_answer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minLines="3"
                android:minHeight="80dp"
                android:padding="18dp"
                android:background="@null"
                android:gravity="top"
                android:hint="Ketik jawaban Anda di sini..."
                android:textColor="@color/phyphox_black_80"
                android:textColorHint="@color/phyphox_black_50"
                android:textSize="15sp"
                android:inputType="textMultiLine|textCapSentences" />
        </androidx.cardview.widget.CardView>

        <Button
            android:id="@+id/btn_submit_experiment_answer"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Submit"
            android:textSize="16sp"
            android:textStyle="bold"
            android:background="@drawable/button_purple"
            android:textColor="@color/phyphox_white_100" />
    </LinearLayout>
</ScrollView>
