<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Development profile: izinkan cleartext trafik pada jaringan lokal -->
    <base-config cleartextTrafficPermitted="true" />

    <!-- Konfigurasi untuk domain tertentu atau alamat IP -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">api.example.com</domain>
        <domain includeSubdomains="true">192.168.1.7</domain>
        <domain includeSubdomains="true">140.115.126.90</domain>
    </domain-config>

    <!-- Konfigurasi untuk akses dari emulator Android -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">10.0.2.2</domain>
    </domain-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">148.230.96.39</domain>
    </domain-config>

</network-security-config>
